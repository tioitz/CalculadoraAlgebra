{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet publish -c Release -o out"
  },
  "deploy": {
    "startCommand": "dotnet CalculadoraAlgebra.dll",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
